# Project root .htaccess — forwards every request into the public/ front-controller
# directory so the document root can stay at the repo root instead of public/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Never serve dotfiles or the framework config/spec files directly.
# (The rewrite above already sends everything into public/, but that only holds
#  while mod_rewrite is enabled — this is the belt-and-braces layer.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# Matched by filename (not by *.json/*.md glob) so this does not cascade down
# into public/ and block a future manifest.json or similar.
<FilesMatch "^(mini_framework|starter_boilerplate_blueprint|PROJECT_BRAIN)\.json$|^(AGENTS|CLAUDE|GEMINI)\.md$">
    Require all denied
</FilesMatch>
